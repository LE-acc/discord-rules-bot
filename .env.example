# ─────────────────────────────────────────────────────────────
# NutriAI environment configuration
# Copy this file to `.env.local` and fill in your keys.
# The app runs in a fully-featured DEMO mode even with no keys set:
# a local rule-based Saudi/Arabic meal parser + local storage is used.
# ─────────────────────────────────────────────────────────────

# ── Supabase (auth + database + storage) ─────────────────────
# Create a project at https://supabase.com and run supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (chat parsing, vision, whisper speech-to-text) ────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

# ── Food & barcode database (Open Food Facts is free & keyless) ─
# Optional commercial providers can be added here.
NEXT_PUBLIC_OPENFOODFACTS_BASE=https://world.openfoodfacts.org

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NutriAI
